# Pinned external tool versions (repository-tooling.md §1, §12).
#
# CI and release workflows source this file so the pins live in one place. The
# Rust toolchain is pinned by `rust-toolchain.toml`; the ESP-IDF version is
# pinned by `flake.lock` (nixpkgs-esp-dev). GitHub Action revisions are pinned by
# full commit SHA inline in the workflow (`uses:`), because a `uses:` value
# cannot be computed at run time.
#
# Keep these in step with:
#   - rust-toolchain.toml (RUST_TOOLCHAIN),
#   - the `wasm-bindgen` crate version in Cargo.lock (WASM_BINDGEN_CLI_VERSION),
#   - flake.lock / AGENTS.md (ESP_IDF_VERSION).

RUST_TOOLCHAIN=1.98.1
TRUNK_VERSION=0.21.14
WASM_BINDGEN_CLI_VERSION=0.2.129
ESP_IDF_VERSION=5.5.2
