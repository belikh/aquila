# Aquila ESP32-S3 CSI node — sdkconfig defaults.
#
# Applied on top of the ESP-IDF defaults by `idf.py` when it creates
# `sdkconfig` (which is generated, not committed). The CSI feature must be
# enabled for esp_wifi_set_csi to compile in.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Firmware OTA (docs/spec/firmware-ota.md). A 4 MB flash and a custom dual-OTA
# (A/B) partition table are required: one image is written to the inactive slot
# and the bootloader can roll back to the other if the new one never confirms.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Pending-verify / rollback: on the first boot of an OTA image the running
# partition starts in ESP_OTA_IMG_PENDING_VERIFY and must be confirmed with
# esp_ota_mark_app_valid_cancel_rollback(), or the bootloader rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# mbedTLS provides SHA-256 for the image digest; the node's control channel
# already links it for HMAC-SHA256.
CONFIG_MBEDTLS_SHA256_C=y
